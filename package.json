{
	"name": "faztore",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"db:setup": "bash database/dev/setup.sh setup",
		"db:up": "pnpm run db:setup",
		"db:down": "tsx database/dev/migrate.ts reset",
		"db:status": "bash database/dev/setup.sh status",
		"db:reset": "bash database/dev/setup.sh reset",
		"db:rebuild": "bash database/dev/setup.sh reset --yes",
		"db:init": "tsx database/dev/migrate.ts init",
		"db:migrate": "tsx database/dev/migrate.ts migrate",
		"db:rollback": "tsx database/dev/migrate.ts rollback",
		"db:check": "tsx database/dev/migrate.ts check",
		"db:create": "tsx database/dev/migrate.ts create",
		"db:generate": "kysely-codegen --config-file kysely.config.ts"
	},
	"packageManager": "pnpm@9.15.4",
	"dependencies": {
		"@floating-ui/dom": "^1.7.5",
		"@lucide/svelte": "^0.575.0",
		"bcryptjs": "^3.0.3",
		"cookie": "^1.1.1",
		"jsonwebtoken": "^9.0.3",
		"kysely": "^0.28.10",
		"lucide-svelte": "^0.563.0",
		"pg": "^8.17.2",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^25.1.0",
		"@types/pg": "^8.16.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.2.0",
		"kysely-codegen": "^0.19.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.49.1",
		"svelte-check": "^4.3.5",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1"
	}
}
