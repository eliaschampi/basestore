{
	"name": "faztore",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"db:setup": "bash database/dev/setup.sh setup",
		"db:status": "bash database/dev/setup.sh status",
		"db:reset": "bash database/dev/setup.sh reset",
		"db:init": "tsx database/dev/migrate.ts init",
		"db:migrate": "tsx database/dev/migrate.ts migrate",
		"db:rollback": "tsx database/dev/migrate.ts rollback",
		"db:check": "tsx database/dev/migrate.ts check",
		"db:create": "tsx database/dev/migrate.ts create",
		"db:generate": "kysely-codegen --config-file kysely.config.ts"
	},
	"packageManager": "pnpm@9.15.4",
	"dependencies": {
		"@floating-ui/dom": "^1.6.12",
		"bcryptjs": "^3.0.2",
		"cookie": "^1.0.2",
		"jsonwebtoken": "^9.0.2",
		"kysely": "^0.28.3",
		"lucide-svelte": "^0.468.0",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.37.0",
		"@sveltejs/adapter-node": "^5.3.3",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/bcryptjs": "^3.0.0",
		"@types/cookie": "^1.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.0.15",
		"@types/pg": "^8.15.4",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^15.14.0",
		"kysely-codegen": "^0.18.5",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.39.11",
		"svelte-check": "^4.3.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^7.1.7"
	}
}
